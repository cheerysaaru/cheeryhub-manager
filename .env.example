# Copy this file to .env and fill in local values.
# Backend variables (server + Worker): see backend/.env.example — that file is
# the full inventory and lists which variables are required where.

# --- Database ---
# SQLite (local dev and CyberPanel server):
DATABASE_URL="file:./dev.db"
# Optional alternative:
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# --- Auth / server (backend reads these) ---
# 32+ characters; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000
NODE_ENV=development

# --- CORS / cookies ---
# Comma-separated allowed origins
FRONTEND_URL="http://localhost:5173"
# Public base path of the frontend (empty for local, /cheeryhub-manager/ for GitHub Pages)
BASE_PATH=""
# Cross-site cookie settings for production:
# COOKIE_SAME_SITE="none"
# COOKIE_SECURE="true"
# COOKIE_DOMAIN=".yourdomain.com"

# --- Rate limits (backend; see backend/.env.example for all of them) ---
# RATE_LIMIT_MAX=600
# AUTH_RATE_LIMIT_MAX=30
# LOGIN_RATE_LIMIT_MAX=5

# --- Frontend ---
# VITE_API_URL="http://localhost:4000/api"

# --- Email verification (Resend) ---
# EMAIL_API_KEY="re_..."
# EMAIL_FROM="Productivity <onboarding@resend.dev>"
# APP_URL="http://localhost:5173"

# --- Socket.IO ---
# FRONTEND_URL used for socket CORS too (same comma-separated list)
