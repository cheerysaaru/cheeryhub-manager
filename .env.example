# Copy this file to .env and fill in local values.

# --- Database ---
# Local dev (SQLite):
DATABASE_URL="file:./dev.db"
# Production (Postgres on Railway/Render):
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000
NODE_ENV=development

# --- CORS / cookies ---
# Comma-separated allowed origins
FRONTEND_URL="http://localhost:5173"
# Public base path of the frontend (empty for local, /personal-productivity-manager for GitHub Pages)
BASE_PATH=""
# Cross-site cookie settings for production:
# COOKIE_SAME_SITE="none"
# COOKIE_SECURE="true"
# COOKIE_DOMAIN=".yourdomain.com"

# --- Frontend ---
# VITE_API_URL="http://localhost:4000/api"

# --- Email verification (Resend) ---
# EMAIL_API_KEY="re_..."
# EMAIL_FROM="Productivity <onboarding@resend.dev>"

# --- Socket.IO ---
# FRONTEND_URL used for socket CORS too (same comma-separated list)

# --- Deploy (Stage 8) ---
# BACKEND_URL="https://your-backend.up.railway.app"
# FRONTEND_URL="https://your-frontend.vercel.app"
