# Copy to backend/.env and fill in real values. The server refuses to start
# if required variables are missing or invalid (values are never printed).

# --- Required ---
# 32+ characters of real randomness — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never reuse the placeholder below, never commit the real value.
JWT_SECRET="replace-with-a-long-random-secret"

# SQLite for local dev / CyberPanel, PostgreSQL for managed hosts.
# Not required when running as a Cloudflare Worker (D1 binding is used).
DATABASE_URL="file:./dev.db"

# --- Server ---
NODE_ENV="development"
PORT=4000
# Max seconds a request (outbound API call) may take before timing out
REQUEST_TIMEOUT_MS=10000

# --- CORS / cookies ---
# Comma-separated allowed browser origins
FRONTEND_URL="http://localhost:5173"
# Public base path of the frontend ("" for local, /cheeryhub-manager/ for GitHub Pages)
BASE_PATH=""
# COOKIE_SAME_SITE="lax"            # use "none" + COOKIE_SECURE="true" cross-site
# COOKIE_SECURE="true"
# COOKIE_DOMAIN=".yourdomain.com"

# --- Rate limits (per client IP, per window) ---
RATE_LIMIT_WINDOW_MS=900000        # 15 minutes
RATE_LIMIT_MAX=600                 # general /api traffic
AUTH_RATE_LIMIT_MAX=30             # auth endpoints (login/logout/refresh/...)
LOGIN_RATE_LIMIT_MAX=5             # failed logins
REGISTER_RATE_LIMIT_MAX=3          # register + forgot-password per hour

# --- Email (Resend). Optional: email sending is skipped when unset. ---
# EMAIL_API_KEY="re_..."
# EMAIL_FROM="Productivity <onboarding@resend.dev>"
# APP_URL="http://localhost:5173"

# --- Frontend (used by Vite, not by the API process) ---
# VITE_API_URL="http://localhost:4000/api"
