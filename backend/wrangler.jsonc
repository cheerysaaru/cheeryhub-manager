{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "personal-productivity-api",

  "main": "src/worker.ts",

  "compatibility_date": "2026-09-23",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "vars": {
    "FRONTEND_URL": "https://personal-productivity-manager.saarkunofficial.workers.dev,http://localhost:5173",
    "NODE_ENV": "production"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-productivity-db",
      "database_id": "dba971a7-05f8-437b-acae-e7b6336bf9f6",
      "migrations_dir": "../prisma/migrations",
      "migrations_pattern": "../prisma/migrations/*/migration.sql"
    }
  ]
}
