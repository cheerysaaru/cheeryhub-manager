{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src", "../shared", "worker-configuration.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.old.ts", "src/**/*.old/**/*"]
}
