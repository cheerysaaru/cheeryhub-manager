{
  "buildCommand": "npm run build --workspace frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/personal-productivity-manager/(.*)", "destination": "/personal-productivity-manager/index.html" },
    { "source": "/personal-productivity-manager", "destination": "/personal-productivity-manager/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
