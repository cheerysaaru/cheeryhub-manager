# Static asset caching for LiteSpeed/Apache (cheeryhub.space origin).
# Vite hashes filenames under /assets/, so those can be cached forever;
# HTML, the manifest and the service worker must revalidate so new deploys
# take effect immediately.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Deny access to repository metadata and server-side files even if older
  # deployments left them behind in the document root.
  RewriteRule ^(?:\.git|\.github|backend|prisma|node_modules|uploads)(?:/|$) - [F,L,NC]
  RewriteRule (^|/)\.env[^/]*(?:/|$) - [F,L,NC]
  RewriteRule \.(?:db(?:-(?:wal|shm|journal))?|sqlite3?(?:-(?:wal|shm|journal))?)(?:$|/) - [F,L,NC]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <LocationMatch "^/assets/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </LocationMatch>

  <FilesMatch "(^|/)(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
